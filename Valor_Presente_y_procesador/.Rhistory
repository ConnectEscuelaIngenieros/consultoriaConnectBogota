cat("AUTOMATIZADOR VARIACIÓN PROMEDIO CON VALOR PRESENTE\n")
cat(rep("=", 80), "\n", sep = "")
# Cargar IPC históricos UNA SOLA VEZ
ipc_data <- cargar_ipc_historicos()
# Cargar datos de fechas UNA SOLA VEZ
cat("\n>>> Cargando Proyecto_fechas.xlsx...\n")
ruta_fechas <- "Proyecto_fechas.xlsx"
if (!file.exists(ruta_fechas)) {
stop("No se encontró el archivo Proyecto_fechas.xlsx")
}
datos_fechas <- read_excel(ruta_fechas, sheet = 1)
cat("Proyecto_fechas cargado:", nrow(datos_fechas), "proyectos\n")
# Buscar archivos de presupuesto
cat("\n>>> Buscando archivos de presupuesto en carpeta input...\n")
archivos <- list.files("input", pattern = "^\\d+.*\\.(xlsx|xls)$", full.names = FALSE, ignore.case = TRUE)
if (length(archivos) == 0) {
cat("❌ No se encontraron archivos de presupuesto\n")
return(NULL)
}
cat("Archivos encontrados:", length(archivos), "\n\n")
# Procesar cada archivo
lista_resultados <- list()
exitosos <- 0
fallidos <- 0
for(archivo in archivos) {
tryCatch({
resultado <- procesar_presupuesto(archivo, ipc_data, datos_fechas)
lista_resultados[[length(lista_resultados) + 1]] <- resultado
exitosos <- exitosos + 1
}, error = function(e) {
fallidos <- fallidos + 1
cat("\n❌ ERROR:", archivo, "-", e$message, "\n")
})
}
cat("\n", rep("=", 80), "\n", sep = "")
cat("RESUMEN DE PROCESAMIENTO\n")
cat(rep("=", 80), "\n", sep = "")
cat("Archivos encontrados:", length(archivos), "\n")
cat("Procesados exitosamente:", exitosos, "\n")
cat("Fallidos:", fallidos, "\n")
cat(rep("=", 80), "\n", sep = "")
# Consolidar resultados
if (length(lista_resultados) > 0) {
cat("\n>>> Generando Excel consolidado...\n")
consolidado <- bind_rows(lista_resultados)
# Crear archivo Excel
if (!dir.exists("output")) dir.create("output")
fecha_actual <- format(Sys.Date(), "%Y%m%d")
nombre_consolidado <- paste0("CONSOLIDADO_VARIACION_PROMEDIO_VP_", fecha_actual, ".xlsx")
archivo_consolidado <- file.path("output", nombre_consolidado)
wb <- createWorkbook()
addWorksheet(wb, "Consolidado VP")
writeData(wb, "Consolidado VP", consolidado)
# Estilos
headerStyle <- createStyle(textDecoration = "bold", fgFill = "#2E75B6", fontColour = "white",
halign = "center", border = "TopBottomLeftRight", wrapText = TRUE, fontSize = 11)
addStyle(wb, "Consolidado VP", headerStyle, rows = 1, cols = 1:ncol(consolidado), gridExpand = TRUE)
numStyle <- createStyle(numFmt = "#,##0.00", halign = "right")
addStyle(wb, "Consolidado VP", numStyle, rows = 2:(nrow(consolidado)+1), cols = 3:6, gridExpand = TRUE)
addStyle(wb, "Consolidado VP", numStyle, rows = 2:(nrow(consolidado)+1), cols = 12:13, gridExpand = TRUE)
dateStyle <- createStyle(numFmt = "DD/MM/YYYY", halign = "center")
addStyle(wb, "Consolidado VP", dateStyle, rows = 2:(nrow(consolidado)+1), cols = 7:9, gridExpand = TRUE)
setColWidths(wb, "Consolidado VP", cols = 1:13,
widths = c(30, 12, 22, 22, 25, 25, 18, 18, 18, 15, 30, 15, 15))
freezePane(wb, "Consolidado VP", firstRow = TRUE)
saveWorkbook(wb, archivo_consolidado, overwrite = TRUE)
cat("\n✅ Excel consolidado generado\n")
cat("Archivo:", archivo_consolidado, "\n")
cat("Proyectos incluidos:", nrow(consolidado), "\n")
cat("\n📊 NOTA: Todos los valores están en VALOR PRESENTE (pesos de",
format(ipc_data$fecha_actual, "%B %Y"), ")\n")
cat(rep("=", 80), "\n", sep = "")
return(list(consolidado = consolidado, archivo = archivo_consolidado))
} else {
cat("\n⚠️ No se procesaron archivos exitosamente\n")
return(NULL)
}
}
######## MENÚ PRINCIPAL ########
menu_principal <- function() {
cat("\n")
cat(rep("=", 80), "\n", sep = "")
cat("   AUTOMATIZADOR VARIACIÓN PROMEDIO CON VALOR PRESENTE\n")
cat("   PROYECTOS ARPRO - IPC BANCO DE LA REPÚBLICA\n")
cat(rep("=", 80), "\n", sep = "")
cat("\n1. Procesar TODOS los presupuestos (recomendado)\n")
cat("2. Salir\n")
cat("\nSeleccione una opción (1-2): ")
opcion <- readline()
if (opcion == "1") {
tryCatch({
resultado <- procesar_presupuesto(
"184 - Seguimiento Insumos.xlsx",
ipc_data = cargar_ipc_historicos(),
datos_fechas = readxl::read_excel("Proyecto_fechas.xlsx")
)
cat("\n✅ PROCESO COMPLETADO EXITOSAMENTE\n")
}, error = function(e) {
cat("\n❌ ERROR:", e$message, "\n")
})
} else if (opcion == "2") {
cat("\nHasta luego!\n")
} else {
cat("\nOpción inválida\n")
}
}
# EJECUTAR
menu_principal()
View(menu_principal)
menu_principal
menu_principal()
########### AUTOMATIZADOR VARIACIÓN PROMEDIO CON VALOR PRESENTE - PROYECTOS ARPRO #################
library(readxl)
library(dplyr)
library(openxlsx)
library(stringr)
library(lubridate)
######## FUNCIÓN PARA LIMPIAR VALORES MONETARIOS ########
limpiar_moneda <- function(x) {
as.numeric(gsub("[^0-9.-]", "", as.character(x)))
}
######## FUNCIÓN PARA CARGAR IPC HISTÓRICOS ########
cargar_ipc_historicos <- function() {
cat("\n>>> Cargando IPC_HISTORICOS.xlsx...\n")
ruta_ipc <- "IPC_HISTORICOS.xlsx"
if (!file.exists(ruta_ipc)) {
stop("No se encontró el archivo IPC_HISTORICOS.xlsx en la ruta actual")
}
# Leer saltando 3 filas de encabezado
IPC_RAW <- read_excel(ruta_ipc, skip = 3, col_names = FALSE)
names(IPC_RAW) <- c("Fecha_Serial", "IPC")
# Limpiar y convertir
IPC_LIMPIO <- IPC_RAW %>%
filter(!is.na(Fecha_Serial), !is.na(IPC)) %>%
mutate(
Fecha_Serial = as.numeric(Fecha_Serial),
IPC = as.numeric(IPC)
) %>%
filter(!is.na(Fecha_Serial), !is.na(IPC)) %>%
mutate(
Fecha = as.Date(Fecha_Serial, origin = "1899-12-30"),
Año = year(Fecha),
Mes = month(Fecha),
Mes_Año = format(Fecha, "%Y-%m")
) %>%
select(Fecha, Año, Mes, Mes_Año, IPC) %>%
arrange(Fecha)
cat("IPC históricos cargados:", nrow(IPC_LIMPIO), "registros\n")
cat("Rango:", format(min(IPC_LIMPIO$Fecha), "%d/%m/%Y"), "a",
format(max(IPC_LIMPIO$Fecha), "%d/%m/%Y"), "\n")
# Obtener IPC más reciente (septiembre 2025)
ipc_actual <- IPC_LIMPIO %>%
filter(Fecha == max(Fecha)) %>%
pull(IPC)
fecha_actual <- max(IPC_LIMPIO$Fecha)
cat("IPC de referencia (más reciente):", ipc_actual,
"- Fecha:", format(fecha_actual, "%d/%m/%Y"), "\n")
return(list(
tabla = IPC_LIMPIO,
ipc_actual = ipc_actual,
fecha_actual = fecha_actual
))
}
######## FUNCIÓN PARA CALCULAR VALOR PRESENTE (VECTORIZADA) ########
calcular_vp <- function(valor_original, ipc_historico, ipc_actual) {
# Crear vector de resultados del mismo tamaño
resultado <- numeric(length(valor_original))
# Calcular para cada elemento
for (i in seq_along(valor_original)) {
if (is.na(valor_original[i]) || is.na(ipc_historico) || ipc_historico == 0) {
resultado[i] <- NA_real_
} else {
factor <- ipc_actual / ipc_historico
resultado[i] <- valor_original[i] * factor
}
}
return(resultado)
}
######## FUNCIÓN PARA EXTRAER CÓDIGO DEL PROYECTO ########
extraer_codigo_proyecto <- function(nombre_archivo) {
codigo <- str_extract(nombre_archivo, "^\\d+")
if (is.na(codigo)) {
warning("No se pudo extraer código del archivo: ", nombre_archivo)
return(NA)
}
return(as.character(codigo))
}
######## FUNCIÓN PARA EXTRAER NOMBRE DEL PROYECTO ########
extraer_nombre_proyecto <- function(ruta_archivo) {
nombre_archivo <- basename(ruta_archivo)
nombre_sin_ext <- tools::file_path_sans_ext(nombre_archivo)
primeras_filas <- read_excel(ruta_archivo, sheet = 1, n_max = 5, col_names = FALSE)
for(i in 1:nrow(primeras_filas)) {
for(j in 1:ncol(primeras_filas)) {
celda <- as.character(primeras_filas[i, j])
if(!is.na(celda) && grepl("Proyecto:", celda, ignore.case = TRUE)) {
nombre <- trimws(gsub(".*Proyecto:?\\s*", "", celda, ignore.case = TRUE))
if(nombre != "" && !is.na(nombre)) {
return(nombre)
}
}
}
}
return(nombre_sin_ext)
}
######## FUNCIÓN PRINCIPAL - PROCESAR PRESUPUESTO CON VP ########
procesar_presupuesto <- function(nombre_archivo_presupuesto, ipc_data, datos_fechas) {
cat("\n", rep("=", 80), "\n", sep = "")
cat("PROCESANDO:", nombre_archivo_presupuesto, "\n")
cat(rep("=", 80), "\n", sep = "")
ruta_presupuesto <- file.path("input", nombre_archivo_presupuesto)
if (!file.exists(ruta_presupuesto)) stop("No se encontró el archivo: ", ruta_presupuesto)
# Extraer código y nombre
codigo_proyecto <- extraer_codigo_proyecto(nombre_archivo_presupuesto)
nombre_proyecto <- extraer_nombre_proyecto(ruta_presupuesto)
cat("Código:", codigo_proyecto, "\n")
cat("Nombre:", nombre_proyecto, "\n")
# Leer datos del presupuesto
cat("\n>>> Leyendo datos del presupuesto...\n")
datos <- read_excel(ruta_presupuesto, sheet = 1, skip = 5)
if (ncol(datos) == 25) {
names(datos) <- c(
"Descripcion", "Tipo", "Codigo", "UM",
"Presup_Cantidad", "Presup_Valor",
"Proy_Cantidad", "Proy_Valor",
"Dif_Cantidad", "Dif_Valor",
"Contratado_Cantidad", "Contratado_Valor",
"Comprado_Cantidad", "Comprado_Valor",
"Asegurado_Cantidad", "Asegurado_Valor",
"Invertido_Cantidad", "Invertido_Valor",
"Consumido_Cantidad", "Consumido_Valor",
"PorConsumir_Cantidad", "PorConsumir_Valor",
"Desviacion_Valor",
"Norma1_ConsuMenorProy",
"Norma2_AsegMenorProy"
)
} else {
stop("Estructura de columnas no reconocida para este tipo de archivo")
}
datos <- datos %>%
mutate(
Presup_Insumo   = Presup_Valor,
Presup_Item     = NA_real_,
Presup_Capitulo = NA_real_,
Proy_Insumo     = Proy_Valor,
Proy_Item       = NA_real_,
Proy_Capitulo   = NA_real_
)
# Limpiar valores monetarios
datos <- datos %>%
mutate(
Presup_Insumo = limpiar_moneda(Presup_Insumo),
Presup_Item = limpiar_moneda(Presup_Item),
Presup_Capitulo = limpiar_moneda(Presup_Capitulo),
Proy_Insumo = limpiar_moneda(Proy_Insumo),
Proy_Item = limpiar_moneda(Proy_Item),
Proy_Capitulo = limpiar_moneda(Proy_Capitulo)
)
# Buscar fecha de elaboración en Proyecto_fechas
cat("\n>>> Buscando fecha de elaboración en Proyecto_fechas...\n")
proyecto_info <- datos_fechas %>%
filter(str_trim(as.character(`Codigo Proyecto`)) == str_trim(as.character(codigo_proyecto)))
if (nrow(proyecto_info) == 0) {
cat("⚠️ ADVERTENCIA: Código", codigo_proyecto, "no encontrado en Proyecto_fechas\n")
cat("   No se aplicará conversión a Valor Presente\n")
fecha_elaboracion <- NA
fecha_inicio <- NA
fecha_finalizacion <- NA
estado <- NA
macroproyecto <- "No pertenece a ningún macroproyecto"
ipc_historico <- NA
factor_ipc <- NA
aplicar_vp <- FALSE
} else {
cat("✅ Proyecto encontrado\n")
fecha_elaboracion <- proyecto_info$`Fecha De Elaboracion`[1]
fecha_inicio <- proyecto_info$`Fecha De Inicio`[1]
fecha_finalizacion <- proyecto_info$`Fecha De Finalizacion`[1]
estado <- proyecto_info$Estado[1]
if ("MacroProyecto" %in% names(proyecto_info)) {
macroproyecto <- ifelse(is.na(proyecto_info$MacroProyecto[1]) | proyecto_info$MacroProyecto[1] == "",
"No pertenece a ningún macroproyecto", proyecto_info$MacroProyecto[1])
} else {
macroproyecto <- "No pertenece a ningún macroproyecto"
}
# Convertir fecha de elaboración
fecha_elab_date <- as.Date(fecha_elaboracion)
mes_año_elab <- format(fecha_elab_date, "%Y-%m")
cat("Fecha de elaboración:", format(fecha_elab_date, "%d/%m/%Y"), "\n")
# Buscar IPC histórico
ipc_historico <- ipc_data$tabla %>%
filter(Mes_Año == mes_año_elab) %>%
pull(IPC)
if (length(ipc_historico) == 0) {
cat("⚠️ No se encontró IPC para", mes_año_elab, "\n")
ipc_historico <- NA
factor_ipc <- NA
aplicar_vp <- FALSE
} else {
cat("IPC histórico encontrado:", ipc_historico, "\n")
factor_ipc <- ipc_data$ipc_actual / ipc_historico
cat("Factor de conversión:", round(factor_ipc, 6), "\n")
aplicar_vp <- TRUE
}
}
# CONVERTIR TODOS LOS VALORES A VALOR PRESENTE
if (aplicar_vp) {
cat("\n>>> Convirtiendo valores a Valor Presente...\n")
datos <- datos %>%
mutate(
# Convertir valores presupuestados
Presup_Insumo_VP = calcular_vp(Presup_Insumo, ipc_historico, ipc_data$ipc_actual),
Presup_Item_VP = calcular_vp(Presup_Item, ipc_historico, ipc_data$ipc_actual),
Presup_Capitulo_VP = calcular_vp(Presup_Capitulo, ipc_historico, ipc_data$ipc_actual),
# Convertir valores proyectados
Proy_Insumo_VP = calcular_vp(Proy_Insumo, ipc_historico, ipc_data$ipc_actual),
Proy_Item_VP = calcular_vp(Proy_Item, ipc_historico, ipc_data$ipc_actual),
Proy_Capitulo_VP = calcular_vp(Proy_Capitulo, ipc_historico, ipc_data$ipc_actual)
)
cat("✅ Conversión a VP completada\n")
} else {
cat("\n⚠️ No se aplicó conversión a VP (usando valores originales)\n")
datos <- datos %>%
mutate(
Presup_Insumo_VP = Presup_Insumo,
Presup_Item_VP = Presup_Item,
Presup_Capitulo_VP = Presup_Capitulo,
Proy_Insumo_VP = Proy_Insumo,
Proy_Item_VP = Proy_Item,
Proy_Capitulo_VP = Proy_Capitulo
)
}
# Identificar tipo de filas
cat("\n>>> Identificando capítulos e items...\n")
datos <- datos %>%
mutate(
Tipo_Fila = case_when(
grepl("^TOTAL", toupper(Descripcion)) ~ "TOTAL",
Tipo %in% c("C", "CAPITULO") ~ "CAPITULO",
Tipo %in% c("I", "ITEM") ~ "ITEM",
TRUE ~ "INSUMO"
)
)
filas_capitulo <- datos %>% filter(Tipo_Fila == "CAPITULO")
filas_item <- datos %>% filter(Tipo_Fila == "ITEM")
cat("Capítulos:", nrow(filas_capitulo), "\n")
cat("Items:", nrow(filas_item), "\n")
# CALCULAR TOTALES EN VP (suma de capítulos en VP)
cat("\n>>> Calculando totales en Valor Presente...\n")
total_presupuestado_vp <- sum(filas_capitulo$Presup_Capitulo_VP, na.rm = TRUE)
total_proyectado_vp <- sum(filas_capitulo$Proy_Capitulo_VP, na.rm = TRUE)
cat("Total Presupuestado VP:", format(round(total_presupuestado_vp, 2), big.mark = ","), "\n")
cat("Total Proyectado VP:   ", format(round(total_proyectado_vp, 2), big.mark = ","), "\n")
# CALCULAR VARIACIÓN PROMEDIO CAPÍTULO EN VP
cat("\n>>> Calculando variación promedio de capítulos en VP...\n")
deltas_capitulo_vp <- filas_capitulo %>%
mutate(Delta_VP = Proy_Capitulo_VP - Presup_Capitulo_VP) %>%
filter(!is.na(Delta_VP))
if (nrow(deltas_capitulo_vp) > 0) {
variacion_promedio_capitulo_vp <- sum(deltas_capitulo_vp$Delta_VP, na.rm = TRUE) / nrow(deltas_capitulo_vp)
} else {
variacion_promedio_capitulo_vp <- 0
}
cat("Variación Promedio Capítulo VP:", format(round(variacion_promedio_capitulo_vp, 2), big.mark = ","), "\n")
# CALCULAR VARIACIÓN PROMEDIO ITEM EN VP
cat("\n>>> Calculando variación promedio de items en VP...\n")
deltas_item_vp <- filas_item %>%
mutate(Delta_VP = Proy_Item_VP - Presup_Item_VP) %>%
filter(!is.na(Delta_VP))
if (nrow(deltas_item_vp) > 0) {
variacion_promedio_item_vp <- sum(deltas_item_vp$Delta_VP, na.rm = TRUE) / nrow(deltas_item_vp)
} else {
variacion_promedio_item_vp <- 0
}
cat("Variación Promedio Item VP:", format(round(variacion_promedio_item_vp, 2), big.mark = ","), "\n")
# Crear resultado
resultado <- list(
resumen = data.frame(
Nombre_Proyecto = nombre_proyecto,
Codigo_Proyecto = codigo_proyecto,
Total_Proyecto_Presupuestado_VP = round(total_presupuestado_vp, 2),
Total_Proyecto_Proyectado_VP = round(total_proyectado_vp, 2),
Variacion_Promedio_Capitulo_VP = round(variacion_promedio_capitulo_vp, 2),
Variacion_Promedio_Item_VP = round(variacion_promedio_item_vp, 2),
Fecha_De_Elaboracion = as.character(fecha_elaboracion),
Fecha_De_Inicio = as.character(fecha_inicio),
Fecha_De_Finalizacion = as.character(fecha_finalizacion),
Estado = as.character(estado),
Macroproyecto = as.character(macroproyecto),
IPC_Historico = ifelse(is.na(ipc_historico), NA, round(ipc_historico, 2)),
Factor_IPC = ifelse(is.na(factor_ipc), NA, round(factor_ipc, 6)),
stringsAsFactors = FALSE
),
detalle = datos  # ← todas las filas procesadas
)
cat("\n✅ Proyecto procesado exitosamente\n")
return(resultado)
}
######## FUNCIÓN PARA PROCESAR MÚLTIPLES PROYECTOS ########
procesar_todos_presupuestos <- function() {
cat("\n", rep("=", 80), "\n", sep = "")
cat("AUTOMATIZADOR VARIACIÓN PROMEDIO CON VALOR PRESENTE\n")
cat(rep("=", 80), "\n", sep = "")
# Cargar IPC históricos UNA SOLA VEZ
ipc_data <- cargar_ipc_historicos()
# Cargar datos de fechas UNA SOLA VEZ
cat("\n>>> Cargando Proyecto_fechas.xlsx...\n")
ruta_fechas <- "Proyecto_fechas.xlsx"
if (!file.exists(ruta_fechas)) {
stop("No se encontró el archivo Proyecto_fechas.xlsx")
}
datos_fechas <- read_excel(ruta_fechas, sheet = 1)
cat("Proyecto_fechas cargado:", nrow(datos_fechas), "proyectos\n")
# Buscar archivos de presupuesto
cat("\n>>> Buscando archivos de presupuesto en carpeta input...\n")
archivos <- list.files("input", pattern = "^\\d+.*\\.(xlsx|xls)$", full.names = FALSE, ignore.case = TRUE)
if (length(archivos) == 0) {
cat("❌ No se encontraron archivos de presupuesto\n")
return(NULL)
}
cat("Archivos encontrados:", length(archivos), "\n\n")
# Procesar cada archivo
lista_resultados <- list()
exitosos <- 0
fallidos <- 0
for(archivo in archivos) {
tryCatch({
resultado <- procesar_presupuesto(archivo, ipc_data, datos_fechas)
lista_resultados[[length(lista_resultados) + 1]] <- resultado
exitosos <- exitosos + 1
}, error = function(e) {
fallidos <- fallidos + 1
cat("\n❌ ERROR:", archivo, "-", e$message, "\n")
})
}
cat("\n", rep("=", 80), "\n", sep = "")
cat("RESUMEN DE PROCESAMIENTO\n")
cat(rep("=", 80), "\n", sep = "")
cat("Archivos encontrados:", length(archivos), "\n")
cat("Procesados exitosamente:", exitosos, "\n")
cat("Fallidos:", fallidos, "\n")
cat(rep("=", 80), "\n", sep = "")
# Consolidar resultados
if (length(lista_resultados) > 0) {
cat("\n>>> Generando Excel consolidado...\n")
consolidado <- bind_rows(lista_resultados)
# Crear archivo Excel
if (!dir.exists("output")) dir.create("output")
fecha_actual <- format(Sys.Date(), "%Y%m%d")
nombre_consolidado <- paste0("CONSOLIDADO_VARIACION_PROMEDIO_VP_", fecha_actual, ".xlsx")
archivo_consolidado <- file.path("output", nombre_consolidado)
wb <- createWorkbook()
addWorksheet(wb, "Consolidado VP")
writeData(wb, "Consolidado VP", consolidado)
# Estilos
headerStyle <- createStyle(textDecoration = "bold", fgFill = "#2E75B6", fontColour = "white",
halign = "center", border = "TopBottomLeftRight", wrapText = TRUE, fontSize = 11)
addStyle(wb, "Consolidado VP", headerStyle, rows = 1, cols = 1:ncol(consolidado), gridExpand = TRUE)
numStyle <- createStyle(numFmt = "#,##0.00", halign = "right")
addStyle(wb, "Consolidado VP", numStyle, rows = 2:(nrow(consolidado)+1), cols = 3:6, gridExpand = TRUE)
addStyle(wb, "Consolidado VP", numStyle, rows = 2:(nrow(consolidado)+1), cols = 12:13, gridExpand = TRUE)
dateStyle <- createStyle(numFmt = "DD/MM/YYYY", halign = "center")
addStyle(wb, "Consolidado VP", dateStyle, rows = 2:(nrow(consolidado)+1), cols = 7:9, gridExpand = TRUE)
setColWidths(wb, "Consolidado VP", cols = 1:13,
widths = c(30, 12, 22, 22, 25, 25, 18, 18, 18, 15, 30, 15, 15))
freezePane(wb, "Consolidado VP", firstRow = TRUE)
saveWorkbook(wb, archivo_consolidado, overwrite = TRUE)
cat("\n✅ Excel consolidado generado\n")
cat("Archivo:", archivo_consolidado, "\n")
cat("Proyectos incluidos:", nrow(consolidado), "\n")
cat("\n📊 NOTA: Todos los valores están en VALOR PRESENTE (pesos de",
format(ipc_data$fecha_actual, "%B %Y"), ")\n")
cat(rep("=", 80), "\n", sep = "")
return(list(consolidado = consolidado, archivo = archivo_consolidado))
} else {
cat("\n⚠️ No se procesaron archivos exitosamente\n")
return(NULL)
}
}
######## MENÚ PRINCIPAL ########
menu_principal <- function() {
cat("\n")
cat(rep("=", 80), "\n", sep = "")
cat("   AUTOMATIZADOR VARIACIÓN PROMEDIO CON VALOR PRESENTE\n")
cat("   PROYECTOS ARPRO - IPC BANCO DE LA REPÚBLICA\n")
cat(rep("=", 80), "\n", sep = "")
cat("\n1. Procesar TODOS los presupuestos (recomendado)\n")
cat("2. Salir\n")
cat("\nSeleccione una opción (1-2): ")
opcion <- readline()
if (opcion == "1") {
tryCatch({
resultado <- procesar_presupuesto(
"184 - Seguimiento Insumos.xlsx",
ipc_data = cargar_ipc_historicos(),
datos_fechas = readxl::read_excel("Proyecto_fechas.xlsx")
)
write.csv(resultado$resumen, "output/resumen.csv", row.names = FALSE)
write.csv(resultado$detalle, "output/detalle.csv", row.names = FALSE)
cat("\n✅ PROCESO COMPLETADO EXITOSAMENTE\n")
}, error = function(e) {
cat("\n❌ ERROR:", e$message, "\n")
})
} else if (opcion == "2") {
cat("\nHasta luego!\n")
} else {
cat("\nOpción inválida\n")
}
}
# EJECUTAR
menu_principal()
View(calcular_vp)
